# Production Environment Configuration
# Copy this to .env.production and fill in actual values

# Django Configuration
DJANGO_SECRET_KEY=your-secure-random-key-here-min-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,www.yourdomain.com
DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com
DJANGO_SUPERUSER_PASSWORD=your-secure-admin-password

# Database Configuration
POSTGRES_DB=jats
POSTGRES_USER=jats_user
POSTGRES_PASSWORD=your-secure-db-password
POSTGRES_HOST=your-database-host
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jats_user:your-secure-db-password@your-database-host:5432/jats

# Redis Configuration
REDIS_URL=redis://:your-redis-password@your-redis-host:6379/0

# FastAPI Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8001
JWT_SECRET_KEY=your-secure-jwt-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Frontend Configuration
VITE_API_URL=https://api.yourdomain.com/api/v1

# Celery Configuration (if using background jobs)
CELERY_TASK_ALWAYS_EAGER=False

# Additional Security
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com
